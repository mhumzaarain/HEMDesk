SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
# Origins the browser uses to reach the app. Required for login/POST under the
# prod settings (DEBUG=False) — must include the scheme and the port you browse
# to. The docker-compose demo serves nginx on 8080:
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
POSTGRES_DB=cmms
POSTGRES_USER=cmms
POSTGRES_PASSWORD=cmms
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
TIME_ZONE=Asia/Karachi
HOSPITAL_NAME=Demo General Hospital

# Shared login password for the demo accounts created by `manage.py seed_demo`
# (users: admin, engineer1-3, staff1-10). Anyone can clone the repo and log in
# with this to try the UI. Change it before any real deployment.
DEMO_PASSWORD=demo1234

# --- Production admin bootstrap (optional) ----------------------------------
# Uncomment and set a REAL password to auto-create the initial admin on deploy
# via `manage.py create_superuser` (idempotent; skips if a superuser exists or
# these are unset). Leave commented to skip and use `createsuperuser`
# interactively instead. NEVER commit a real password — set it only in your
# private .env. After first login, create real per-person accounts in /admin/.
# SUPERUSER_USERNAME=admin
# SUPERUSER_EMAIL=admin@hospital.example
# SUPERUSER_PASSWORD=
# SUPERUSER_EMPLOYEE_ID=ADMIN-0001

# --- LLM backend (Phase 2) --------------------------------------------------
# Any OpenAI-compatible endpoint. Defaults target the bundled ollama container.
# Examples:
#   vLLM:          LLM_BASE_URL=http://vllm-host:8000/v1
#   hospital API:  LLM_BASE_URL=https://llm.hospital.example/v1  + LLM_API_KEY
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=
LLM_MODEL=llama3.2:3b
LLM_TIMEOUT_SECONDS=120
LLM_INTERACTIVE_TIMEOUT_SECONDS=30
# Extra JSON merged into every request body, for backend quirks, e.g.
# {"chat_template_kwargs": {"enable_thinking": false}}
LLM_EXTRA_BODY={}

# --- Embedding backend (Phase 3, hybrid manual search) -----------------------
# Any OpenAI-compatible /v1/embeddings endpoint. Defaults to the bundled
# Ollama; pull the model once:  docker compose exec ollama ollama pull nomic-embed-text
#   vLLM example:  EMBEDDING_BASE_URL=http://vllm-host:8000/v1
#                  EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
# EMBEDDING_DIM is schema-coupled: changing it after deploy requires a new
# migration and `manage.py reembed_manuals`. Larger native vectors are
# truncated to EMBEDDING_DIM (Matryoshka); smaller ones are rejected.
EMBEDDING_BASE_URL=http://ollama:11434/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_BATCH_SIZE=64
